<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NCKU 國立成功大學行動校園 App</title>
    <!-- 載入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 載入 Font Awesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- 載入 Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ncku: {
                            DEFAULT: '#8B1D24',
                            dark: '#631217',
                            light: '#A92831',
                            soft: '#FDF2F3'
                        }
                    },
                    fontFamily: {
                        sans: ['"Inter"', '"Noto Sans TC"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* 隱藏手機畫面內部滾動條但保留滑動手感 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* 擬真 iPhone 16 Pro 鈦金屬硬體外框特效 */
        .iphone-frame {
            width: 392px;
            height: 844px;
            border-radius: 56px;
            background: #0f1115;
            padding: 12px;
            box-shadow:
                0 0 0 2px #3b3f46,
                0 0 0 5px #1c1e22,
                0 30px 70px -15px rgba(0, 0, 0, 0.75),
                inset 0 0 8px rgba(255, 255, 255, 0.18);
            position: relative;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* 內部 OLED 顯示器螢幕圓角 */
        .iphone-screen {
            width: 100%;
            height: 100%;
            border-radius: 45px;
            overflow: hidden;
            position: relative;
            background: #F4F5F7;
            display: flex;
            flex-direction: column;
        }

        /* 手機側邊實體金屬按鍵 */
        .hw-btn-left-1 {
            position: absolute;
            left: -7px;
            top: 132px;
            width: 4px;
            height: 28px;
            background: linear-gradient(180deg, #4b5058, #272a30);
            border-radius: 4px 0 0 4px;
        }
        .hw-btn-left-2 {
            position: absolute;
            left: -7px;
            top: 182px;
            width: 4px;
            height: 54px;
            background: linear-gradient(180deg, #4b5058, #272a30);
            border-radius: 4px 0 0 4px;
        }
        .hw-btn-left-3 {
            position: absolute;
            left: -7px;
            top: 248px;
            width: 4px;
            height: 54px;
            background: linear-gradient(180deg, #4b5058, #272a30);
            border-radius: 4px 0 0 4px;
        }
        .hw-btn-right {
            position: absolute;
            right: -7px;
            top: 204px;
            width: 4px;
            height: 78px;
            background: linear-gradient(180deg, #4b5058, #272a30);
            border-radius: 0 4px 4px 0;
        }

        /* 原生 App 點擊回饋動畫 */
        .ios-tap:active {
            transform: scale(0.95);
            opacity: 0.85;
        }

        /* 分頁切換過渡動畫 */
        .app-page {
            animation: appFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes appFadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* 底部上滑抽屜 (Bottom Sheet) 動畫 */
        .sheet-enter {
            animation: sheetSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes sheetSlideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }

        /* 抖動編輯動畫 (類似 iOS 主畫面編輯圖示) */
        @keyframes iconJiggle {
            0% { transform: rotate(-1.5deg); }
            50% { transform: rotate(1.5deg); }
            100% { transform: rotate(-1.5deg); }
        }
        .jiggle-mode {
            animation: iconJiggle 0.28s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-950 via-slate-900 to-stone-900 min-h-screen flex flex-col items-center justify-center p-2 sm:p-4 select-none font-sans overflow-x-hidden">

    <!-- 頂部模擬器環境提示列（可切換手機外框縮放或重置 App） -->
    <div class="w-full max-w-[392px] flex items-center justify-between mb-2.5 px-3.5 py-2 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-white text-xs shadow-lg">
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-semibold tracking-wide">NCKU Mobile App 模擬器</span>
            <span class="text-[10px] bg-ncku px-2 py-0.5 rounded-full text-rose-100 font-bold">iOS 學生版</span>
        </div>
        <div class="flex items-center gap-1.5">
            <button onclick="triggerDynamicIsland('成大校園網路 NCKU-WiFi 已連線', 'fa-wifi text-emerald-400')" class="px-2 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-[11px] transition" title="測試動態島通知">
                <i class="fa-solid fa-bell"></i>
            </button>
            <button onclick="resetApp()" class="px-2.5 py-1 rounded-lg bg-ncku hover:bg-ncku-light text-[11px] font-semibold transition">
                <i class="fa-solid fa-rotate-right mr-1"></i>回首頁
            </button>
        </div>
    </div>

    <!-- ==================== 擬真 iPhone 16 Pro 智慧型手機硬體外框 ==================== -->
    <div id="phoneHardware" class="iphone-frame">
        <!-- 機身左側靜音鍵與音量鍵、右側電源鍵 -->
        <div class="hw-btn-left-1" title="動作按鈕"></div>
        <div class="hw-btn-left-2" title="音量 +"></div>
        <div class="hw-btn-left-3" title="音量 -"></div>
        <div class="hw-btn-right" title="電源鍵"></div>

        <!-- 手機內部 OLED 螢幕 -->
        <div class="iphone-screen">

            <!-- 1. iOS 頂部狀態列 + 動態島 (Dynamic Island) -->
            <div class="bg-ncku text-white pt-2.5 pb-1.5 px-6 flex items-center justify-between text-xs font-semibold relative z-40 shrink-0">
                <!-- 左側時間 -->
                <span id="iosStatusBarClock" class="tracking-tight font-bold text-[13px] w-14">09:41</span>

                <!-- 中央動態島 (Dynamic Island - 可點擊展開即時活動) -->
                <div id="dynamicIsland" onclick="triggerDynamicIsland('下節課：10:10 資料結構 (資訊館 65104)', 'fa-graduation-cap text-amber-300')" class="bg-black text-white h-[26px] min-w-[116px] max-w-[230px] px-3 rounded-full flex items-center justify-between gap-2 shadow-md cursor-pointer transition-all duration-300 border border-white/10">
                    <div class="flex items-center gap-1.5 overflow-hidden">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                        <span id="islandText" class="text-[10px] text-slate-200 truncate font-medium">NCKU 學生端</span>
                    </div>
                    <!-- 鏡頭孔視覺 -->
                    <div class="w-2.5 h-2.5 rounded-full bg-[#151821] border border-indigo-900/60 shrink-0"></div>
                </div>

                <!-- 右側電信訊號 / 5G / 電池圖示 -->
                <div class="flex items-center justify-end gap-1.5 w-14 text-[11px]">
                    <i class="fa-solid fa-signal text-[10px]"></i>
                    <i class="fa-solid fa-wifi text-[10px]"></i>
                    <i class="fa-solid fa-battery-full text-[13px]"></i>
                </div>
            </div>

            <!-- 2. 原生 App 頂部導覽列 (Navigation Bar) -->
            <header class="bg-ncku text-white px-4 pt-1 pb-3 flex items-center justify-between shadow-sm relative z-30 shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-white/15 backdrop-blur flex items-center justify-center border border-white/25 shadow-inner">
                        <i class="fa-solid fa-graduation-cap text-amber-300 text-sm"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h1 id="appNavTitle" class="text-[15px] font-bold tracking-tight leading-none">成功大學行動校園</h1>
                        </div>
                        <p id="appNavSubtitle" class="text-[10px] text-rose-100/80 mt-0.5">National Cheng Kung University</p>
                    </div>
                </div>

                <!-- 右側快速搜尋與常見問題捷徑 -->
                <div class="flex items-center gap-1.5">
                    <button onclick="openServiceSheet('event_system')" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center ios-tap transition" title="活動資訊系統">
                        <i class="fa-solid fa-calendar-check text-xs text-amber-300"></i>
                    </button>
                    <button onclick="switchTab('profile'); setTimeout(scrollToFaqSection, 120);" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center ios-tap transition" title="學生常見問題">
                        <i class="fa-solid fa-circle-question text-xs"></i>
                    </button>
                </div>
            </header>

            <!-- 3. 手機螢幕中央可捲動視窗 (Mobile Scroll Viewport) -->
            <main id="phoneViewport" class="flex-1 overflow-y-auto no-scrollbar bg-[#F3F4F6] pb-24 relative">

                <!-- ==================== TAB 1: 首頁 (僅含「個人資訊」與「可客製化常用校園服務」) ==================== -->
                <section id="tab-home" class="tab-view app-page">
                    <!-- 頂部酒紅弧形背景延伸 -->
                    <div class="bg-ncku h-12 rounded-b-[28px] shadow-xs"></div>

                    <div class="px-3.5 -mt-9 space-y-3.5">
                        <!-- (A) 學生個人資訊卡 (顯示「在學中」，不顯示校區、不顯示通行碼與統計列) -->
                        <div class="bg-white rounded-3xl p-4 shadow-md border border-slate-100 relative overflow-hidden">
                            <!-- 成大榕樹裝飾浮水印 -->
                            <i class="fa-solid fa-tree text-7xl text-ncku/[0.04] absolute -right-2 -bottom-3 pointer-events-none"></i>

                            <div class="flex items-center justify-between relative z-10">
                                <div class="flex items-center gap-3.5">
                                    <!-- 學生頭像 -->
                                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-ncku to-ncku-light text-white flex flex-col items-center justify-center shadow-md border-2 border-rose-100 shrink-0">
                                        <span class="text-lg font-black leading-none">王</span>
                                        <span class="text-[9px] text-rose-100 mt-0.5 font-mono">NCKU</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <h2 class="text-base font-extrabold text-slate-900">王成功</h2>
                                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>在學中
                                            </span>
                                        </div>
                                        <p class="text-xs font-semibold text-slate-600 mt-1">電機資訊學院 · 資訊工程學系三年級</p>
                                        <p class="text-[11px] text-slate-400 font-mono mt-0.5">學號：F74123456</p>
                                    </div>
                                </div>

                                <button onclick="switchTab('profile')" class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 hover:text-ncku flex items-center justify-center ios-tap transition shrink-0" title="檢視學生檔案">
                                    <i class="fa-solid fa-chevron-right text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <!-- (B) 常用校園服務 (可客製化新增、移除、調整順序，含「活動資訊系統」) -->
                        <div class="bg-white rounded-3xl p-4 shadow-sm border border-slate-100">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="w-1.5 h-4 rounded-full bg-ncku"></span>
                                    <div>
                                        <h3 class="text-sm font-extrabold text-slate-800 leading-none">常用校園服務</h3>
                                        <p id="homeServiceSubtitle" class="text-[10px] text-slate-400 mt-1">點選圖示開啟服務，或點擊右側客製化調整</p>
                                    </div>
                                </div>

                                <div class="flex items-center gap-1.5">
                                    <button id="jiggleEditBtn" onclick="toggleHomeJiggleEdit()" class="px-2.5 py-1.5 rounded-full bg-rose-50 text-ncku font-bold text-[11px] flex items-center gap-1 ios-tap transition">
                                        <i class="fa-solid fa-sliders text-[10px]"></i>
                                        <span>客製化</span>
                                    </button>
                                </div>
                            </div>

                            <!-- 編輯模式提示橫幅 (預設隱藏) -->
                            <div id="jiggleModeBanner" class="hidden mb-3 p-2.5 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-center justify-between text-[11px] text-amber-900">
                                <span class="font-medium"><i class="fa-solid fa-hand-pointer text-amber-600 mr-1"></i>點擊左上角「-」移除，或開服務庫新增</span>
                                <div class="flex items-center gap-1">
                                    <button onclick="openCustomizeBottomSheet()" class="px-2 py-1 rounded-lg bg-ncku text-white font-bold text-[10px] ios-tap">+ 服務庫</button>
                                    <button onclick="resetDefaultServices()" class="px-2 py-1 rounded-lg bg-white border border-amber-300 text-amber-900 font-semibold text-[10px] ios-tap">還原</button>
                                </div>
                            </div>

                            <!-- App 圖示網格 (4 欄原生手機 App Icon 排版) -->
                            <div id="pinnedAppGrid" class="grid grid-cols-4 gap-y-4 gap-x-2 text-center pt-1">
                                <!-- 由 JavaScript 動態渲染 -->
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ==================== TAB 2: 課表 (直接顯示一週所有課程，無「進入課程」按鈕) ==================== -->
                <section id="tab-academic" class="tab-view app-page hidden p-3 space-y-3">
                    <!-- 頂部學期資訊與目前點選課程摘要卡 -->
                    <div class="bg-white rounded-3xl p-3.5 shadow-sm border border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                            <div>
                                <h2 class="text-sm font-extrabold text-slate-800">115-1 學期一週課表</h2>
                                <p class="text-[10px] text-slate-400">共 7 門課 · 18 學分（點擊任一課程格查看詳情）</p>
                            </div>
                            <span class="text-[10px] font-bold bg-ncku/10 text-ncku px-2.5 py-1 rounded-full">週一 ~ 週五</span>
                        </div>

                        <!-- 點擊課表後顯示的課程詳細資訊卡 (無「進入課程」按鈕) -->
                        <div id="timetableSelectedCard" class="p-2.5 rounded-2xl bg-gradient-to-r from-rose-50 via-rose-50/60 to-amber-50/40 border border-rose-200/70 flex items-center justify-between">
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span id="ttCourseType" class="text-[10px] font-bold bg-ncku text-white px-1.5 py-0.5 rounded-md">必修 · 3 學分</span>
                                    <h3 id="ttCourseTitle" class="text-xs font-extrabold text-slate-900">資料結構與演算法</h3>
                                </div>
                                <p id="ttCourseInfo" class="text-[11px] text-slate-600 mt-1">
                                    <i class="fa-solid fa-location-dot text-ncku mr-1"></i>成功校區 資訊館 65104 · 林教授 · 週一 3-4 / 週四 2
                                </p>
                            </div>
                        </div>

                        <!-- 手機版一週五天完整課表網格 (第 1 節 08:10 ~ 第 9 節 17:10) -->
                        <div class="mt-2.5 rounded-2xl border border-slate-200 overflow-hidden">
                            <table class="w-full table-fixed border-collapse text-center">
                                <thead>
                                    <tr class="bg-slate-100 text-slate-700 text-[10px] font-extrabold border-b border-slate-200">
                                        <th class="w-8 py-1.5 border-r border-slate-200 text-slate-400">節</th>
                                        <th class="py-1.5 border-r border-slate-200">一</th>
                                        <th class="py-1.5 border-r border-slate-200">二</th>
                                        <th class="py-1.5 border-r border-slate-200">三</th>
                                        <th class="py-1.5 border-r border-slate-200">四</th>
                                        <th class="py-1.5">五</th>
                                    </tr>
                                </thead>
                                <tbody id="mobileTimetableGrid" class="divide-y divide-slate-200 text-[10px]">
                                    <!-- 由 JS 渲染第 1~9 節完整一週課表 -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 本學期修課科目總覽清單 (純資訊呈現，無任何「進入課程」按鈕) -->
                    <div class="bg-white rounded-3xl p-3.5 shadow-sm border border-slate-100">
                        <h3 class="text-xs font-extrabold text-slate-700 mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-book-bookmark text-ncku"></i>本學期修習科目明細
                        </h3>
                        <div id="mobileCourseList" class="space-y-2">
                            <!-- 由 JS 動態渲染 -->
                        </div>
                    </div>
                </section>

                <!-- ==================== TAB 3: 校園 (雙區塊切換：1.地圖教室與Wi-Fi / 2.自修室圖書館與學餐販賣機) ==================== -->
                <section id="tab-services" class="tab-view app-page hidden p-3 space-y-3">

                    <!-- iOS 風格頂部分段控制器 (Segmented Control) -->
                    <div class="bg-slate-200/90 p-1 rounded-2xl grid grid-cols-2 gap-1 shadow-inner">
                        <button id="campusSegBtn-map" onclick="switchCampusMode('map')" class="py-2 px-2 rounded-xl text-[11px] font-extrabold bg-white text-ncku shadow-xs transition flex items-center justify-center gap-1.5 ios-tap">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <span>地圖教室 · Wi-Fi</span>
                        </button>
                        <button id="campusSegBtn-live" onclick="switchCampusMode('live')" class="py-2 px-2 rounded-xl text-[11px] font-bold text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1.5 ios-tap">
                            <i class="fa-solid fa-users-viewfinder"></i>
                            <span>自修室 · 學餐販賣機</span>
                        </button>
                    </div>

                    <!-- 區塊 (1)：互動式八大校區地圖、教室資訊、Wi-Fi 密碼 -->
                    <div id="campusPanel-map" class="space-y-3">
                        <div class="bg-white rounded-3xl p-3.5 shadow-sm border border-slate-100">
                            <div class="flex items-center justify-between mb-2">
                                <div>
                                    <h3 class="text-xs font-extrabold text-slate-800">成大八大校區互動地圖</h3>
                                    <p class="text-[10px] text-slate-400">點選地圖上的校區查看系館教室代碼與空堂狀態</p>
                                </div>
                                <span id="selectedCampusPill" class="text-[10px] font-bold bg-ncku text-white px-2.5 py-0.5 rounded-full">成功校區</span>
                            </div>

                            <!-- 手機專用互動式校區平面圖 (含道路與校區區塊) -->
                            <div class="relative w-full h-52 rounded-2xl overflow-hidden border border-slate-200 bg-[#e8f0ec] shadow-inner">
                                <svg viewBox="0 0 340 210" class="w-full h-full">
                                    <rect width="340" height="210" fill="#e6efe9"/>
                                    <!-- 校區綠地底塊 (僅繪製八大校區對應位置，左下角留白) -->
                                    <rect x="10" y="10" width="98" height="56" rx="8" fill="#d5e6da"/>
                                    <rect x="118" y="10" width="98" height="56" rx="8" fill="#d5e6da"/>
                                    <rect x="226" y="10" width="104" height="56" rx="8" fill="#d5e6da"/>
                                    <rect x="10" y="76" width="98" height="64" rx="8" fill="#cde2d3"/>
                                    <rect x="118" y="76" width="98" height="64" rx="8" fill="#cde2d3"/>
                                    <rect x="226" y="76" width="104" height="64" rx="8" fill="#cde2d3"/>
                                    <!-- 中間下方為勝利校區，右下方為東寧校區 -->
                                    <rect x="118" y="150" width="98" height="50" rx="8" fill="#d5e6da"/>
                                    <rect x="226" y="150" width="104" height="50" rx="8" fill="#d5e6da"/>

                                    <!-- 道路：小東路、大學路、勝利路、長榮路 -->
                                    <line x1="0" y1="71" x2="340" y2="71" stroke="#ffffff" stroke-width="6"/>
                                    <line x1="0" y1="145" x2="340" y2="145" stroke="#ffffff" stroke-width="6"/>
                                    <line x1="113" y1="0" x2="113" y2="210" stroke="#ffffff" stroke-width="6"/>
                                    <line x1="221" y1="0" x2="221" y2="210" stroke="#ffffff" stroke-width="6"/>

                                    <text x="45" y="69" font-size="6.5" fill="#64748b" font-weight="bold">小東路</text>
                                    <text x="45" y="143" font-size="6.5" fill="#64748b" font-weight="bold">大學路</text>
                                    <text x="105" y="38" font-size="6.5" fill="#64748b" font-weight="bold" writing-mode="tb">勝利路</text>
