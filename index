                        <p class="text-xs text-slate-500 leading-relaxed">您正在使用「${svc.name}」行動快速介面，所有紀錄將即時與成大計網中心校務資料庫同步。</p>
                    </div>
                    <button onclick="showToast('已同步「${svc.name}」最新資料'); closeSheet('servicePreviewSheet');" class="w-full py-2.5 bg-ncku text-white rounded-2xl font-bold text-xs ios-tap">重新整理資料</button>
                `;
            }

            document.getElementById('servicePreviewSheet').classList.remove('hidden');
        }

        function closeSheet(sheetId) {
            document.getElementById(sheetId).classList.add('hidden');
        }

        // ==================== 課表分頁：渲染一週五天第 1~9 節完整課表（無進入課程按鈕） ====================
        function renderWeeklySchedule() {
            const tbody = document.getElementById('mobileTimetableGrid');
            let html = '';

            periodSlots.forEach(slot => {
                let rowCells = `
                    <td class="py-1.5 px-0.5 bg-slate-50 border-r border-slate-200">
                        <div class="text-[10px] font-extrabold text-slate-700">${slot.p}</div>
                        <div class="text-[8px] text-slate-400 font-mono">${slot.time}</div>
                    </td>
                `;

                for (let day = 1; day <= 5; day++) {
                    const course = weeklyCourses.find(c => c.cells.some(cell => cell.d === day && cell.p === slot.p));
                    if (course) {
                        rowCells += `
                            <td onclick="selectCourseOnTimetable('${course.id}')" class="p-0.5 border-r border-slate-100 last:border-r-0 align-top cursor-pointer">
                                <div class="w-full min-h-[40px] rounded-lg border p-1 flex flex-col justify-between ${course.style} ios-tap transition">
                                    <span class="font-extrabold text-[9.5px] leading-tight line-clamp-2">${course.short}</span>
                                    <span class="text-[8px] font-mono opacity-85 mt-0.5">${course.code}</span>
                                </div>
                            </td>
                        `;
                    } else {
                        rowCells += `<td class="p-0.5 border-r border-slate-100 last:border-r-0 bg-white"></td>`;
                    }
                }
                html += `<tr>${rowCells}</tr>`;
            });

            tbody.innerHTML = html;

            // 渲染下方修課清單（純資訊，不放置任何「進入課程」按鈕）
            document.getElementById('mobileCourseList').innerHTML = weeklyCourses.map(c => `
                <div onclick="selectCourseOnTimetable('${c.id}')" class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200/60 flex items-center justify-between ios-tap cursor-pointer transition">
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs font-extrabold text-slate-800">${c.name}</span>
                            <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-white border border-slate-200 text-slate-600">${c.type}</span>
                        </div>
                        <p class="text-[10px] text-slate-500 mt-0.5">${c.timeText} · ${c.room} · ${c.teacher}</p>
                    </div>
                    <span class="text-[10px] font-mono font-bold text-ncku bg-rose-50 px-2 py-0.5 rounded-lg shrink-0">${c.code}</span>
                </div>
            `).join('');
        }

        function selectCourseOnTimetable(courseId) {
            const c = weeklyCourses.find(item => item.id === courseId);
            if (!c) return;
            document.getElementById('ttCourseType').textContent = c.type;
            document.getElementById('ttCourseTitle').textContent = c.name;
            document.getElementById('ttCourseInfo').innerHTML = `<i class="fa-solid fa-location-dot text-ncku mr-1"></i>${c.room} · ${c.teacher} · ${c.timeText}`;
            showToast(`${c.name}（教室：${c.room}）`);
        }

        // ==================== 校園分頁：雙區塊切換 (1.校區地圖與Wi-Fi / 2.自修室與學餐販賣機) ====================
        function switchCampusMode(mode) {
            const mapPanel = document.getElementById('campusPanel-map');
            const livePanel = document.getElementById('campusPanel-live');
            const mapBtn = document.getElementById('campusSegBtn-map');
            const liveBtn = document.getElementById('campusSegBtn-live');

            if (mode === 'map') {
                mapPanel.classList.remove('hidden');
                livePanel.classList.add('hidden');
                mapBtn.className = 'py-2 px-2 rounded-xl text-[11px] font-extrabold bg-white text-ncku shadow-xs transition flex items-center justify-center gap-1.5 ios-tap';
                liveBtn.className = 'py-2 px-2 rounded-xl text-[11px] font-bold text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1.5 ios-tap';
            } else {
                mapPanel.classList.add('hidden');
                livePanel.classList.remove('hidden');
                liveBtn.className = 'py-2 px-2 rounded-xl text-[11px] font-extrabold bg-white text-ncku shadow-xs transition flex items-center justify-center gap-1.5 ios-tap';
                mapBtn.className = 'py-2 px-2 rounded-xl text-[11px] font-bold text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1.5 ios-tap';
                renderLiveCampusSection();
            }
        }

        function selectCampusOnMap(key) {
            const info = campusData[key];
            if (!info) return;

            Object.keys(campusData).forEach(k => {
                const btn = document.getElementById(`pin-${k}`);
                if (!btn) return;
                const spans = btn.querySelectorAll('span');
                if (k === key) {
                    btn.classList.remove('bg-white/95', 'border-slate-300');
                    btn.classList.add('bg-ncku', 'text-white', 'border-2', 'border-amber-300', 'shadow-md');
                    if (spans[0]) spans[0].className = 'text-xs font-extrabold text-white';
                } else {
                    btn.classList.remove('bg-ncku', 'text-white', 'border-2', 'border-amber-300', 'shadow-md');
                    btn.classList.add('bg-white/95', 'border-slate-300');
                    if (spans[0]) spans[0].className = 'text-xs font-extrabold text-slate-700';
                }
            });

            document.getElementById('selectedCampusPill').textContent = info.name;
            document.getElementById('campusClassroomTitle').innerHTML = `<i class="fa-solid fa-building-columns text-ncku"></i><span>${info.name}：系館教室資訊</span>`;
            document.getElementById('campusCodeTag').textContent = info.codeTag;

            document.getElementById('campusBuildingList').innerHTML = info.buildings.map(b => `
                <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200/70 flex items-start justify-between gap-2">
                    <div>
                        <h5 class="text-xs font-extrabold text-slate-800">${b.bName}</h5>
                        <p class="text-[10px] text-slate-500 mt-0.5"><i class="fa-solid fa-door-open text-slate-400 mr-1"></i>${b.rooms}</p>
                    </div>
                    <span class="text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-lg shrink-0">${b.status}</span>
                </div>
            `).join('');
        }

        function renderLiveCampusSection() {
            // 1. 自修室與圖書館即時人數
            document.getElementById('liveStudyRoomsContainer').innerHTML = studyRoomsState.map(r => {
                const pct = Math.min(100, Math.round((r.cur / r.max) * 100));
                let barColor = 'bg-emerald-500';
                let badge = '空位充足';
                let badgeStyle = 'bg-emerald-100 text-emerald-800';
                if (pct >= 80) {
                    barColor = 'bg-rose-500';
                    badge = '座位擁擠';
                    badgeStyle = 'bg-rose-100 text-rose-800';
                } else if (pct >= 55) {
                    barColor = 'bg-amber-500';
                    badge = '人潮適中';
                    badgeStyle = 'bg-amber-100 text-amber-900';
                }

                return `
                    <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200/70 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-extrabold text-slate-800">${r.name}</span>
                                <span class="text-[9px] bg-white border border-slate-200 text-slate-500 px-1.5 py-0.2 rounded">${r.area}</span>
                            </div>
                            <span class="text-[9px] font-bold px-2 py-0.5 rounded-full ${badgeStyle}">${badge}</span>
                        </div>
                        <div class="flex justify-between text-[10px] text-slate-600">
                            <span>目前人數：<strong class="font-mono text-slate-900">${r.cur}</strong> / ${r.max} 席 (${pct}%)</span>
                            <span class="text-slate-400">${r.hours}</span>
                        </div>
                        <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full ${barColor} rounded-full transition-all duration-300" style="width:${pct}%"></div>
                        </div>
                        <p class="text-[10px] text-slate-500">${r.info}</p>
                    </div>
                `;
            }).join('');

            // 2. 學餐即時情況
            document.getElementById('liveCafeteriaContainer').innerHTML = cafeteriasState.map(c => `
                <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200/70 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold text-slate-800">${c.name}</span>
                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full ${c.badge}">${c.status}</span>
                    </div>
                    <p class="text-[10px] text-slate-500">${c.detail}</p>
                </div>
            `).join('');

            // 3. 販賣機即時情況
            document.getElementById('liveVendingContainer').innerHTML = vendingState.map(v => `
                <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200/70 flex items-start justify-between gap-2">
                    <div>
                        <h5 class="text-xs font-extrabold text-slate-800">${v.name}</h5>
                        <p class="text-[10px] text-slate-500 mt-0.5">${v.detail}</p>
                    </div>
                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-lg shrink-0 ${v.badge}">${v.status}</span>
                </div>
            `).join('');
        }

        function refreshLiveCampusData() {
            studyRoomsState = studyRoomsState.map(r => {
                const delta = Math.floor(Math.random() * 9) - 4;
                return { ...r, cur: Math.max(12, Math.min(r.max - 4, r.cur + delta)) };
            });
            renderLiveCampusSection();
            showToast('已同步自修室、圖書館與學餐最新人數');
        }

        // ==================== 我的分頁：渲染 22 題學生常見問題 (FAQ) ====================
        function renderFaqCategories() {
            const cats = ['全部', '教務選課', '圖書自修', '網路與IT', '住宿生活', '行政獎助'];
            document.getElementById('faqCatContainer').innerHTML = cats.map(c => `
                <button onclick="setFaqCat('${c}')" class="px-2.5 py-1 rounded-full text-[10px] font-bold shrink-0 ios-tap transition ${activeFaqCat === c ? 'bg-ncku text-white' : 'bg-slate-100 text-slate-600'}">
                    ${c}
                </button>
            `).join('');
        }

        function setFaqCat(cat) {
            activeFaqCat = cat;
            renderFaqCategories();
            renderFaqList();
        }

        function renderFaqList() {
            const kw = (document.getElementById('faqSearchInput')?.value || '').trim().toLowerCase();
            const filtered = studentFaqs.filter(item => {
                const cMatch = activeFaqCat === '全部' || item.cat === activeFaqCat;
                const kMatch = !kw || item.q.toLowerCase().includes(kw) || item.a.toLowerCase().includes(kw);
                return cMatch && kMatch;
            });

            const container = document.getElementById('faqListContainer');
            if (filtered.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">找不到相符的問題，請嘗試其他關鍵字</p>`;
                return;
            }

            container.innerHTML = filtered.map(item => `
                <div class="rounded-2xl border border-slate-200/80 bg-slate-50/70 overflow-hidden">
                    <button onclick="toggleFaqItem(${item.id})" class="w-full px-3 py-2.5 text-left flex items-start justify-between gap-2 ios-tap">
                        <div>
                            <span class="inline-block text-[9px] font-bold text-ncku bg-rose-50 border border-rose-200/60 px-1.5 py-0.2 rounded mb-0.5">${item.cat}</span>
                            <h4 class="text-xs font-extrabold text-slate-800 leading-snug">${item.q}</h4>
                        </div>
                        <i id="faqChev-${item.id}" class="fa-solid fa-chevron-down text-[10px] text-slate-400 mt-1 transition-transform"></i>
                    </button>
                    <div id="faqAns-${item.id}" class="hidden px-3 pb-3 pt-1.5 text-[11px] text-slate-600 leading-relaxed bg-white border-t border-slate-100">
                        ${item.a}
                    </div>
                </div>
            `).join('');
        }

        function toggleFaqItem(id) {
            const ans = document.getElementById(`faqAns-${id}`);
            const chev = document.getElementById(`faqChev-${id}`);
            if (!ans) return;
            ans.classList.toggle('hidden');
            if (chev) chev.classList.toggle('rotate-180');
        }

        let allFaqOpen = false;
        function toggleExpandAllFaq() {
            allFaqOpen = !allFaqOpen;
            studentFaqs.forEach(item => {
                const ans = document.getElementById(`faqAns-${item.id}`);
                const chev = document.getElementById(`faqChev-${item.id}`);
                if (ans) {
                    if (allFaqOpen) {
                        ans.classList.remove('hidden');
                        if (chev) chev.classList.add('rotate-180');
                    } else {
                        ans.classList.add('hidden');
                        if (chev) chev.classList.remove('rotate-180');
                    }
                }
            });
            document.getElementById('expandAllFaqBtn').textContent = allFaqOpen ? '全部收合' : '全部展開';
        }

        function scrollToFaqSection() {
            const el = document.getElementById('studentFaqCard');
            if (el) el.scrollIntoView({ behavior: 'smooth' });
        }

        // ==================== 手機底部分頁切換、動態島與輔助功能 ====================
        function switchTab(tabKey) {
            document.querySelectorAll('.tab-view').forEach(s => s.classList.add('hidden'));
            const target = document.getElementById(`tab-${tabKey}`);
            if (target) target.classList.remove('hidden');

            const titles = {
                home: ['成功大學行動校園', 'National Cheng Kung University'],
                academic: ['一週課程時間表', '115 學年度第 1 學期 · 18 學分'],
                services: ['成大校園地圖與動態', '教室 Wi-Fi · 自修室 · 學餐販賣機'],
                messages: ['個人推播通知', 'Moodle · 活動系統 · 圖書館提醒'],
                profile: ['我的學生檔案與 FAQ', 'F74123456 · 22 項常見問題解答']
            };

            if (titles[tabKey]) {
                document.getElementById('appNavTitle').textContent = titles[tabKey][0];
                document.getElementById('appNavSubtitle').textContent = titles[tabKey][1];
            }

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-ncku');
                btn.classList.add('text-slate-400');
            });
            const activeBtn = document.getElementById(`nav-${tabKey}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-400');
                activeBtn.classList.add('text-ncku');
            }

            document.getElementById('phoneViewport').scrollTop = 0;
        }

        function triggerDynamicIsland(message, iconClass) {
            const island = document.getElementById('dynamicIsland');
            const text = document.getElementById('islandText');
            island.classList.add('scale-105', 'bg-slate-950');
            text.innerHTML = `<i class="fa-solid ${iconClass} mr-1"></i>${message}`;
            showToast(message);
            setTimeout(() => {
                island.classList.remove('scale-105', 'bg-slate-950');
                text.textContent = 'NCKU 學生端';
            }, 3200);
        }

        function copyToClipboard(text, msg) {
            const input = document.createElement('textarea');
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showToast(msg);
        }

        let toastTimer = null;
        function showToast(msg) {
            const toast = document.getElementById('phoneToast');
            document.getElementById('phoneToastText').textContent = msg;
            toast.classList.remove('opacity-0');
            toast.classList.add('opacity-100');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0');
            }, 2300);
        }

        function resetApp() {
            isJiggleMode = false;
            closeSheet('customizeSheet');
            closeSheet('servicePreviewSheet');
            switchTab('home');
            renderHomeServices();
            showToast('已回到成大 App 首頁');
        }

        function updateStatusBarClock() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('iosStatusBarClock').textContent = `${hh}:${mm}`;
        }

        window.onload = function() {
            updateStatusBarClock();
            setInterval(updateStatusBarClock, 20000);
            renderHomeServices();
            renderWeeklySchedule();
            selectCampusOnMap('chengkung');
            renderLiveCampusSection();
            renderFaqCategories();
            renderFaqList();
        };
    </script>
</body>
</html>
