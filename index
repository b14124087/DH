        // ==================== 首頁：渲染可客製化常用校園服務 ====================
        function renderHomeServices() {
            const grid = document.getElementById('pinnedAppGrid');
            const pinned = appServices.filter(s => s.pinned);

            let html = pinned.map((svc, idx) => `
                <div class="relative flex flex-col items-center group ${isJiggleMode ? 'jiggle-mode' : ''}">
                    ${isJiggleMode ? `
                        <button onclick="unpinService('${svc.id}')" class="absolute -top-1.5 left-2 w-5 h-5 rounded-full bg-rose-600 text-white text-[10px] flex items-center justify-center shadow-md z-10" title="移除">
                            <i class="fa-solid fa-minus"></i>
                        </button>
                        <div class="absolute -top-1.5 right-2 flex gap-0.5 z-10">
                            ${idx > 0 ? `<button onclick="movePinnedService(${idx}, -1)" class="w-4 h-4 rounded-full bg-slate-800 text-white text-[8px] flex items-center justify-center"><i class="fa-solid fa-chevron-left"></i></button>` : ''}
                            ${idx < pinned.length - 1 ? `<button onclick="movePinnedService(${idx}, 1)" class="w-4 h-4 rounded-full bg-slate-800 text-white text-[8px] flex items-center justify-center"><i class="fa-solid fa-chevron-right"></i></button>` : ''}
                        </div>
                    ` : ''}
                    <button onclick="${isJiggleMode ? `openCustomizeBottomSheet()` : `handleServiceTap('${svc.id}')`}" class="w-[52px] h-[52px] rounded-[18px] ${svc.bg} ${svc.color} flex items-center justify-center shadow-xs border border-black/[0.04] ios-tap transition">
                        ${getServiceIconHtml(svc, 'text-lg')}
                    </button>
                    <span class="text-[11px] font-bold text-slate-700 mt-1.5 leading-tight line-clamp-1">${svc.name}</span>
                </div>
            `).join('');

            // 最末格固定提供「+ 調整」捷徑按鈕
            html += `
                <div class="flex flex-col items-center">
                    <button onclick="openCustomizeBottomSheet()" class="w-[52px] h-[52px] rounded-[18px] bg-slate-50 border-2 border-dashed border-slate-300 text-slate-400 hover:border-ncku hover:text-ncku flex items-center justify-center ios-tap transition">
                        <i class="fa-solid fa-plus text-base"></i>
                    </button>
                    <span class="text-[11px] font-semibold text-slate-400 mt-1.5">新增/調整</span>
                </div>
            `;

            grid.innerHTML = html;
        }

        function toggleHomeJiggleEdit() {
            isJiggleMode = !isJiggleMode;
            const btn = document.getElementById('jiggleEditBtn');
            const banner = document.getElementById('jiggleModeBanner');

            if (isJiggleMode) {
                btn.className = 'px-2.5 py-1.5 rounded-full bg-ncku text-white font-bold text-[11px] flex items-center gap-1 ios-tap transition';
                btn.innerHTML = '<i class="fa-solid fa-check text-[10px]"></i><span>完成</span>';
                banner.classList.remove('hidden');
            } else {
                btn.className = 'px-2.5 py-1.5 rounded-full bg-rose-50 text-ncku font-bold text-[11px] flex items-center gap-1 ios-tap transition';
                btn.innerHTML = '<i class="fa-solid fa-sliders text-[10px]"></i><span>客製化</span>';
                banner.classList.add('hidden');
            }
            renderHomeServices();
        }

        function unpinService(id) {
            const pinnedCount = appServices.filter(s => s.pinned).length;
            if (pinnedCount <= 1) {
                showToast('首頁請至少保留 1 項常用校園服務');
                return;
            }
            const item = appServices.find(s => s.id === id);
            if (item) {
                item.pinned = false;
                renderHomeServices();
                renderCustomizeSheetLists();
                showToast(`已從首頁移除「${item.name}」`);
            }
        }

        function pinService(id) {
            const item = appServices.find(s => s.id === id);
            if (item) {
                item.pinned = true;
                renderHomeServices();
                renderCustomizeSheetLists();
                showToast(`已將「${item.name}」加入首頁`);
            }
        }

        function movePinnedService(pinnedIdx, dir) {
            const pinned = appServices.filter(s => s.pinned);
            const targetIdx = pinnedIdx + dir;
            if (targetIdx < 0 || targetIdx >= pinned.length) return;

            const idxA = appServices.findIndex(s => s.id === pinned[pinnedIdx].id);
            const idxB = appServices.findIndex(s => s.id === pinned[targetIdx].id);
            const temp = appServices[idxA];
            appServices[idxA] = appServices[idxB];
            appServices[idxB] = temp;

            renderHomeServices();
            renderCustomizeSheetLists();
        }

        function addCustomUserService() {
            const input = document.getElementById('customSvcInput');
            const name = input.value.trim();
            if (!name) {
                showToast('請輸入自訂服務名稱');
                return;
            }
            appServices.push({
                id: 'custom_' + Date.now(),
                name: name,
                icon: 'fa-star',
                bg: 'bg-rose-50',
                color: 'text-ncku',
                desc: '學生個人自訂校園服務捷徑',
                pinned: true
            });
            input.value = '';
            renderHomeServices();
            renderCustomizeSheetLists();
            showToast(`已新增並釘選「${name}」`);
        }

        function resetDefaultServices() {
            appServices = JSON.parse(JSON.stringify(defaultServices));
            renderHomeServices();
            renderCustomizeSheetLists();
            showToast('已還原預設常用校園服務');
        }

        function openCustomizeBottomSheet() {
            renderCustomizeSheetLists();
            document.getElementById('customizeSheet').classList.remove('hidden');
        }

        function renderCustomizeSheetLists() {
            const pinned = appServices.filter(s => s.pinned);
            const unpinned = appServices.filter(s => !s.pinned);

            document.getElementById('sheetPinnedCount').textContent = pinned.length;

            document.getElementById('sheetPinnedList').innerHTML = pinned.map((s, idx) => `
                <div class="p-2 rounded-2xl bg-slate-50 border border-slate-200/70 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-xl ${s.bg} ${s.color} flex items-center justify-center">
                            ${getServiceIconHtml(s, 'text-xs')}
                        </div>
                        <div>
                            <span class="text-xs font-extrabold text-slate-800">${s.name}</span>
                            <p class="text-[10px] text-slate-400">${s.desc}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <button onclick="movePinnedService(${idx}, -1)" ${idx === 0 ? 'disabled class="opacity-30 w-6 h-6"' : 'class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 text-[10px]"'}><i class="fa-solid fa-arrow-up"></i></button>
                        <button onclick="movePinnedService(${idx}, 1)" ${idx === pinned.length - 1 ? 'disabled class="opacity-30 w-6 h-6"' : 'class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 text-[10px]"'}><i class="fa-solid fa-arrow-down"></i></button>
                        <button onclick="unpinService('${s.id}')" class="px-2 py-1 rounded-lg bg-rose-50 text-rose-600 font-bold text-[10px] ml-1">移除</button>
                    </div>
                </div>
            `).join('');

            document.getElementById('sheetAvailableList').innerHTML = unpinned.length === 0
                ? `<p class="col-span-2 text-[11px] text-slate-400 text-center py-2">所有服務皆已加入首頁</p>`
                : unpinned.map(s => `
                    <div class="p-2 rounded-2xl border border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-7 h-7 rounded-xl ${s.bg} ${s.color} flex items-center justify-center shrink-0">
                                ${getServiceIconHtml(s, 'text-xs')}
                            </div>
                            <span class="text-xs font-bold text-slate-700 truncate">${s.name}</span>
                        </div>
                        <button onclick="pinService('${s.id}')" class="px-2 py-1 rounded-lg bg-ncku text-white text-[10px] font-bold shrink-0">+ 加入</button>
                    </div>
                `).join('');
        }

        // 點擊首頁服務圖示的導向與原生 Bottom Sheet 預覽
        function handleServiceTap(serviceId) {
            if (serviceId === 'timetable') {
                switchTab('academic');
                return;
            }
            if (serviceId === 'map') {
                switchTab('services');
                switchCampusMode('map');
                return;
            }
            if (serviceId === 'library' || serviceId === 'food') {
                switchTab('services');
                switchCampusMode('live');
                return;
            }
            openServiceSheet(serviceId);
        }

